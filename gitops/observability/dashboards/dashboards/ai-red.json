{
  "title": "DevBoard AI — RED",
  "uid": "devboard-ai-red",
  "tags": [
    "devboard",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Stack",
        "type": "custom",
        "query": "devboard,devboard-helm",
        "current": {
          "text": "devboard",
          "value": "devboard"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Rate, Errors, Duration — application and Envoy telemetry",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "description": "Request rate derived from OpenTelemetry span metrics for the AI service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"ai-service\"}[5m]))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error ratio",
      "description": "Server-side 5xx responses divided by all DevBoard requests, derived from Envoy Gateway metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "((sum(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"httproute/devboard/.*\",envoy_response_code_class=\"5\"}[5m])) or vector(0)) / clamp_min(sum(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"httproute/devboard/.*\"}[5m])), 0.0001))",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "DevBoard upstream request latency derived from Envoy Gateway histogram metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"httproute/devboard/.*\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"httproute/devboard/.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"httproute/devboard/.*\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "What the app THINKS happened vs what ACTUALLY happened",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "The two counters",
      "description": "The app's own ai_service_requests_total is incremented BEFORE the stream runs (main.py), so it records 200 forever and can never observe a model failure. The span-derived series tells the truth. This panel is left deliberately broken — fixing the counter is the exercise in chapter 12.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(ai_service_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "app counter — status {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (status_code) (rate(traces_span_metrics_calls_total{service_name=\"ai-service\"}[5m]))",
          "legendFormat": "spans — {{status_code}}",
          "refId": "B"
        }
      ]
    }
  ]
}
